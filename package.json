{
  "name": "keypress",
  "productName": "Keypress",
  "version": "1.0.7",
  "description": "Lightweight macOS utility that displays keyboard input as a floating overlay",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "patch-package && npx @electron/rebuild -f -w uiohook-napi",
    "start": "electron .",
    "build": "npm run build:silicon && npm run build:intel",
    "build:silicon": "electron-builder --mac --arm64",
    "build:intel": "electron-builder --mac --x64",
    "build:yml": "node scripts/mergeYml.js",
    "build:publish": "npm run build:silicon -- --publish always && npm run build:intel -- --publish always"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "electron": "^39.5.0",
    "electron-builder": "^26.0.0",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "electron-conf": "^1.3.0",
    "electron-updater": "^6.8.3",
    "uiohook-napi": "^1.5.4"
  }
}
