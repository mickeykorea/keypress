+            } else {
+                // Generic handler for unhandled NX system keys
+                // (brightness, mission control, spotlight, dictation, DND, etc.)
+                // Encode NX_KEYTYPE in rawcode as 0xE0 | key_code.
+                event.time = timestamp;
